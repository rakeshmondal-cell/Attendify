MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=attendify
MYSQL_PASSWORD=Attendify_Dev_2026!
MYSQL_DATABASE=attendify
PORT=4000

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_PROTOCOL=smtp
MAIL_USERNAME=maintenance@msrlimited.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=maintenance@msrlimited.com
MAIL_SMTP_SSL=false

# true = also return OTP in API response (local/dev). false = email only.
ATTENDIFY_SHOW_OTP=true

# Project Management integration (work-list reminders + allocations + attendance gate)
PM_BASE_URL=https://pm.example.com
PM_BEARER_TOKEN=
# Alternative to bearer: PM_API_KEY= (sent as X-API-Key)
# Same secret is accepted on GET /integrations/pm/attendance-status for Project Control write gating.
PM_WEB_APP_URL=https://pm.example.com/login?callbackUrl=%2F

# Write-back to Project Control. OFF until the HTTPS address is confirmed.
# PM_WRITE_TOKEN is a separate key from PM_BEARER_TOKEN. Do not commit the real token.
# Changes wait in pm_sync_outbox. This flag only controls sending.
PM_WRITE_ENABLED=false
PM_WRITE_TOKEN=
PM_TASK_UPDATE_PATH=/api/integrations/attendance/task-updates
# Attendance reports are queued on check-in and check-out. Sending stays off until Project Control adds the endpoint.
PM_ATTENDANCE_WRITE_ENABLED=false
PM_ATTENDANCE_REPORT_PATH=/api/integrations/attendance/reports
# New projects added on the Work tab are queued. Sending stays off until Project Control publishes a create endpoint.
# The path below is a placeholder, not confirmed by Project Control.
PM_TASK_CREATE_ENABLED=false
PM_TASK_CREATE_PATH=/api/integrations/attendance/tasks
PM_WRITE_TIMEOUT_MS=8000
PM_SYNC_POLL_MS=15000
PM_SYNC_MAX_ATTEMPTS=20

# TEMPORARY dummy Work-tab projects — delete after final development
ATTENDIFY_DUMMY_PM=false
ATTENDIFY_DUMMY_PM_WEB_URL=http://10.0.2.2:4000/dummy-project-control.html

WORK_LIST_REMINDER_HOURS=4
WORK_LIST_JOB_POLL_MS=30000
WORK_LIST_PM_TIMEOUT_MS=4000
WORK_LIST_MAX_ATTEMPTS=8

# Firebase Admin for FCM (path to service account JSON, or raw JSON string)
FIREBASE_SERVICE_ACCOUNT_JSON=
